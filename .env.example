FIRECRAWL_API_KEY=your_firecrawl_api_key
OPENAI_API_KEY=your_openai_api_key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_key
SERPER_API_KEY=your_serper_api_key
SMTP_SERVER=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SENDER_EMAIL=sender@example.com
RECIPIENT_EMAILS=recipient1@example.com,recipient2@example.com

# Link-reputation check (optional). A Google Safe Browsing Lookup API v4 key;
# absent or blank = the check is off (nothing changes). With it set, every
# candidate URL is looked up before the scrape and every URL the report could
# render before assembly; a flagged page is dropped. Any failure degrades to
# "no check" with a warning — it never fails a run.
SAFE_BROWSING_API_KEY=

# ZoomInfo endpoint overrides (optional — defaults to published GTM paths).
# Used by scripts/enrich_targets.py; auth reuses ZOOMINFO_CLIENT_ID/SECRET.
# Default enrich path:  https://api.zoominfo.com/gtm/data/v1/companies/enrich
# Default search path:  https://api.zoominfo.com/gtm/data/v1/companies/search
ZOOMINFO_ENRICH_ENDPOINT=
ZOOMINFO_SEARCH_ENDPOINT=
